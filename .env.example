# ==============================================================================
# COBRIX - CONFIGURACIÓN DE VARIABLES DE ENTORNO UNIFICADA (.env)
# ==============================================================================
HOST=127.0.0.1
NODE_ENV=development
SANDBOX_TODAY=2026-10-13

# ------------------------------------------------------------------------------
# 1. COBRIX REST API BACKEND
# ------------------------------------------------------------------------------
# Puerto del servidor backend REST de Cobrix (API, Swagger UI, OpenAPI)
API_PORT=4300

# Base de datos SQLite del sistema Cobrix
COBRIX_DB_PATH=data/cobrix.sqlite

# Token de seguridad obligatorio (Bearer / X-API-Key) para endpoints protegidos
COBRIX_API_KEY=cbx_live_sec_99a81f472bc0e3d1

# Intervalo del scheduler en segundo plano para verificar sincronización diaria automática (en segundos).
# Para pruebas o sandbox se usa 60s; en producción se recomienda un valor mayor (e.g. 300 o 600 segundos).
SCHEDULER_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# 2. COBRIX FRONTEND (REACT SPA)
# ------------------------------------------------------------------------------
# Puerto del servidor web que sirve el panel React SPA
FRONTEND_PORT=3000

# URL directa de la API de Cobrix a la que llamará el navegador del cliente
VITE_API_URL=http://127.0.0.1:4300/api/v1

# Token de seguridad que inyecta la SPA en las peticiones HTTP
VITE_API_KEY=cbx_live_sec_99a81f472bc0e3d1

# ------------------------------------------------------------------------------
# 3. ISP BILLING API (SIMULADOR EXTERNO DEL PROVEEDOR)
# ------------------------------------------------------------------------------
# Puerto del simulador externo del administrador de facturación del ISP
BILLING_API_PORT=4310

# Base de datos SQLite del proveedor simulador
BILLING_API_DB=data/billing-api.sqlite
