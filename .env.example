# ==============================================================================
# COBRIX FACTURATION SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Node runtime environment
NODE_ENV=development

# Web Server & REST API Port
PORT=4300
HOST=127.0.0.1

# ISP Billing API Simulator (External billing service)
BILLING_API_PORT=4310
BILLING_API_DB=data/billing-api.sqlite

# Cobrix Core SQLite Database
COBRIX_DB_PATH=data/cobrix.sqlite

# Test Sandbox Execution Date (YYYY-MM-DD pinned for reproducibility)
SANDBOX_TODAY=2026-10-13

# Cobrix REST API Security Token (Bearer Token / X-API-Key)
# Header: "Authorization: Bearer cbx_live_sec_99a81f472bc0e3d1" or "X-API-Key: cbx_live_sec_99a81f472bc0e3d1"
COBRIX_API_KEY=cbx_live_sec_99a81f472bc0e3d1

# Frontend Client API Key (Exposed to Vite bundle)
VITE_API_KEY=cbx_live_sec_99a81f472bc0e3d1
